# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# grpc-netty-shaded is excluded (only LanguageTool's remote ML rules use it, never on device).
-dontwarn io.grpc.netty.shaded.**
# Likewise excluded: Lucene (n-gram language model) and Google's common protos (gRPC status details).
-dontwarn org.apache.lucene.**
-dontwarn com.google.rpc.**
-dontwarn com.google.api.**
-dontwarn com.google.type.**
-dontwarn com.google.longrunning.**

# R8 with optimization.packageScope moved Kotlin multi-file facade parts (e.g. CollectionsKt__IteratorsKt)
# into another package while their package-private superclass stayed, crashing on start with IllegalAccessError.
-keepnames class kotlin.**
